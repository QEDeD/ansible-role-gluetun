VPN_SERVICE_PROVIDER={{ gluetun_vpn_service_provider }}
VPN_TYPE={{ gluetun_vpn_type }}
VPN_INTERFACE=tun0

OPENVPN_USER_SECRETFILE=/run/secrets/openvpn_user
OPENVPN_PASSWORD_SECRETFILE=/run/secrets/openvpn_password
OPENVPN_CLIENTCRT_SECRETFILE=/run/secrets/openvpn_clientcrt
OPENVPN_CLIENTKEY_SECRETFILE=/run/secrets/openvpn_clientkey
OPENVPN_ENCRYPTED_KEY_SECRETFILE=/run/secrets/openvpn_encrypted_key
OPENVPN_KEY_PASSPHRASE_SECRETFILE=/run/secrets/openvpn_key_passphrase

WIREGUARD_CONF_SECRETFILE=/run/secrets/wg0.conf
WIREGUARD_PRIVATE_KEY_SECRETFILE=/run/secrets/wireguard_private_key
WIREGUARD_PRESHARED_KEY_SECRETFILE=/run/secrets/wireguard_preshared_key
WIREGUARD_ADDRESSES_SECRETFILE=/run/secrets/wireguard_addresses
WIREGUARD_ALLOWED_IPS=0.0.0.0/0

FIREWALL_ENABLED_DISABLING_IT_SHOOTS_YOU_IN_YOUR_FOOT=on
FIREWALL_DEBUG=off
FIREWALL_INPUT_PORTS=
FIREWALL_VPN_INPUT_PORTS=
FIREWALL_OUTBOUND_SUBNETS=

DNS_SERVER=on
DNS_ADDRESS=127.0.0.1
DNS_KEEP_NAMESERVER=off
DNS_UPSTREAM_RESOLVER_TYPE={{ gluetun_dns_upstream_resolver_type }}
DNS_UPSTREAM_RESOLVERS={{ gluetun_dns_upstream_resolvers | join(',') }}
DNS_UPSTREAM_IPV6=off

HEALTH_SERVER_ADDRESS=127.0.0.1:9999
HEALTH_TARGET_ADDRESSES={{ gluetun_health_target_addresses | join(',') }}
HEALTH_ICMP_TARGET_IPS={{ gluetun_health_icmp_target_ips | join(',') }}
HEALTH_RESTART_VPN=on

HTTP_CONTROL_SERVER_ADDRESS=127.0.0.1:8000
HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE={}
HTTP_CONTROL_SERVER_AUTH_CONFIG_FILEPATH={{ gluetun_control_server_auth_config_container_path }}

HTTPPROXY=off
SHADOWSOCKS=off
VPN_PORT_FORWARDING=off
PPROF_ENABLED=no
UPDATER_PERIOD=0

PUID={{ gluetun_uid }}
PGID={{ gluetun_gid }}
TZ={{ gluetun_environment_variables_tz }}

{% for item in gluetun_vpn_provider_environment_variables_custom | dict2items | sort(attribute='key') %}
{{ item.key }}={{ item.value }}
{% endfor %}
