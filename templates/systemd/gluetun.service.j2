[Unit]
# MASH-Role=Gluetun-namespace-owner
Description=Gluetun VPN namespace owner ({{ gluetun_identifier }})
RefuseManualStart=no
RefuseManualStop=no
{% for service in gluetun_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in gluetun_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
{% for service in gluetun_systemd_dependent_services_list %}
Wants={{ service }}
{% endfor %}

[Service]
Type=simple
TimeoutStartSec={{ gluetun_systemd_start_timeout_seconds }}
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
RuntimeDirectory={{ gluetun_identifier }}-container
RuntimeDirectoryMode=0700
ExecStartPre={{ gluetun_container_helper_path | quote }} cleanup
ExecStartPre={{ gluetun_container_helper_path | quote }} create
ExecStart={{ gluetun_container_helper_path | quote }} start

# This command is intentionally not prefixed with "-". A failed or timed-out
# health gate fails the systemd start job, so protected consumers ordered after
# this unit cannot start against an unready namespace owner.
ExecStartPost={{ gluetun_container_helper_path | quote }} health
ExecStop={{ gluetun_container_helper_path | quote }} stop

# ExecStopPost also runs after a failed ExecStartPost. It guarantees that an
# unhealthy owner container cannot be left behind after a failed start job.
ExecStopPost={{ gluetun_container_helper_path | quote }} cleanup

Restart=always
RestartSec=30
SyslogIdentifier={{ gluetun_identifier }}

[Install]
WantedBy=multi-user.target
